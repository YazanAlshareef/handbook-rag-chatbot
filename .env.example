# Copy to .env.local and fill in. Never commit .env.local.

# "gemini" = real model (needs key). "fixture" = offline demo, no key.
LLM_PROVIDER=fixture

# Server-side only. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model names live here so you can change them without touching code.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Retrieval: below this top cosine score the app refuses to answer.
# Leave blank to use the per-provider default in lib/config.ts.
RAG_MIN_SCORE=

# API limits (optional)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=500
